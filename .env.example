# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored — never commit real keys.
#
# All values are in the Supabase dashboard of your project.

# Project Settings -> API (or Data API) -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Project Settings -> API Keys -> "Publishable key" (sb_publishable_…),
# or the legacy "anon" key. Safe to expose to the browser: every table is
# protected by row-level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project Settings -> API Keys -> "Secret key" (sb_secret_…),
# or the legacy "service_role" key. SERVER ONLY: it bypasses row-level
# security. Used to create member accounts and reset passwords.
SUPABASE_SECRET_KEY=

# Connect (top bar) -> "Session pooler" connection string, with your
# database password filled in. Used only by the CLI to apply migrations.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
